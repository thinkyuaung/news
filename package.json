{
  "name": "bbc-news-reader",
  "private": true,
  "version": "1.0.0",
  "description": "Learning project: a BBC news reader built with React + Vite, hosted on GitHub Pages.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "playwright test --project=chromium --project=mobile",
    "test:ui": "playwright test --ui",
    "test:live": "playwright test --project=live",
    "test:report": "playwright show-report"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@vitejs/plugin-react": "^6.1.2",
    "prettier": "^3.9.10",
    "vite": "^8.3.5"
  }
}
